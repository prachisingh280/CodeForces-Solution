#include <bits/stdc++.h>
using namespace std;
 
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
     int n;
     cin>>n; 
     int arr[n];
     int k;
     cin>>k;
     
     for(int i=0; i<n; i++)
     {
         cin>>arr[i];
     }
     
     bool found = false;
     for(int i=0; i<n; i++)
     {
         if(arr[i]== k)
         {
             found = true;
             break;
         }
         
     }
     if(found) cout<<"yes";
     else cout<<"no";
     cout<<"
";
    }
     
}
 
 